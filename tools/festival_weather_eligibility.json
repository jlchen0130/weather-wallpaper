{
  "schema_version": 1,
  "policy": {
    "ordinary_all_day": ["cloudy", "overcast", "light_rain"],
    "adverse_requires_historical_evidence": [
      "heavy_rain",
      "typhoon",
      "fog",
      "haze",
      "strong_wind",
      "thunder_shower",
      "thunderstorm",
      "heatwave",
      "cold_wave"
    ],
    "evidence_period": "1940-01-01 through 2025-12-31",
    "qualification_rule": "Only CWA station observations and CWA typhoon records qualify an adverse weather type. Screening data alone never qualifies generation.",
    "thresholds": {
      "heavy_rain": "daily precipitation >= 80 mm",
      "strong_wind": "daily maximum gust >= 62 km/h (Beaufort force 8)",
      "thunderstorm": "WMO weather code 95-99",
      "thunder_shower": "same-day thunderstorm evidence",
      "heatwave": "daily maximum temperature >= 36 C",
      "cold_wave": "daily minimum temperature <= 10 C",
      "typhoon": "CWA typhoon warning active on the calendar date with local adverse observation evidence",
      "fog": "requires local visibility evidence; absent until verified",
      "haze": "requires local visibility/air-quality evidence; absent until verified"
    }
  },
  "sources": [
    {
      "name": "CWA CODiS climate observation service",
      "url": "https://codis.cwa.gov.tw/StationData?target=weather1",
      "use": "authoritative station-observation reference and field definitions"
    },
    {
      "name": "CWA Typhoon Database",
      "url": "https://rdc28.cwa.gov.tw/TDB/public/advanced_query/",
      "use": "authoritative typhoon warning dates and Taiwan impact descriptions"
    },
    {
      "name": "Open-Meteo Historical Weather API",
      "url": "https://archive-api.open-meteo.com/v1/archive",
      "use": "screening only; not accepted as final evidence for generation eligibility"
    }
  ],
